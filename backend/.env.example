
NODE_ENV=development
PORT=10000
DATABASE_URL=postgres://user:password@localhost:5432/scope_development
DATABASE_SSL=false
API_TOKEN=
API_TOKEN_AUTH_ENABLED=false
CORS_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.invalid
SENDGRID_API_KEY=
SESSION_DAYS=14
INVITE_DAYS=7
RESET_HOURS=2
MAX_UPLOAD_BYTES=5242880

# Development uses memory. Production deployments must override this with postgres.
RATE_LIMIT_STORE=memory
# Keep 0 unless the backend is behind exactly this many trusted reverse proxies.
RATE_LIMIT_TRUST_PROXY_HOPS=0

# Optional one-time login seeding. Passwords are generated if omitted.
ADMIN_EMAIL=your.email@cos.edu
ADMIN_EMPLOYEE_ID=ADMIN-001
ADMIN_FULL_NAME=Your Name
ADMIN_DIVISION=
ADMIN_PASSWORD=
SEED_DEMO_USERS=false
DEMO_FACULTY_EMAIL=faculty.demo@cos.edu
DEMO_FACULTY_NAME=Demo Part-Time Faculty
DEMO_FACULTY_DIVISION=Example Division
DEMO_FACULTY_PASSWORD=
DEMO_CHAIR_EMAIL=chair.demo@cos.edu
DEMO_CHAIR_NAME=Demo Division Chair
DEMO_CHAIR_DIVISION=Example Division
DEMO_CHAIR_PASSWORD=
DEMO_DEAN_EMAIL=dean.demo@cos.edu
DEMO_DEAN_NAME=Demo Dean
DEMO_DEAN_DIVISION=Example Division
DEMO_DEAN_PASSWORD=

# Local development only. Do not set this in production.
AUTH_DISABLED=false

# Development/debug only. Production API responses suppress invite/reset bearer URLs.
ALLOW_TOKEN_URLS_IN_RESPONSES=false
